# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/chinmayi_events

# Auth — JWT_SECRET signs admin sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin account, seeded on boot only when no admin exists yet.
ADMIN_EMAIL=admin@chinmayievents.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Set to "true" for one boot to rotate the password above, then unset it.
ADMIN_PASSWORD_RESET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed browser origins (comma-free, one per variable)
FRONTEND_URL=
SEO_FRONTEND_URL=
NEW_FRONTEND_URL=

# Enquiry notifications. Leave blank to disable — leads are still saved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_NOTIFY_TO=
