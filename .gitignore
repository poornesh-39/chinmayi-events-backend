# ===============================
# Lock files (keep only one)
# ===============================
# package-lock.json is the tracked lockfile and what the deploy builds from.
# Installing with another package manager locally is fine, but its lockfile
# must not be committed — two lockfiles let the deploy resolve a different
# dependency tree than the one tested here.
pnpm-lock.yaml
pnpm-workspace.yaml
yarn.lock
